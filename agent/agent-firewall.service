[Unit]
Description=Block the cloud metadata service (which serves user-data, incl. the bot token) for the agent user
Before=agent-poll.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Rootless Docker sends container traffic out through slirp4netns, which runs as `agent`,
# so this rule covers containers too.
ExecStart=/bin/sh -c 'iptables -C OUTPUT -m owner --uid-owner agent -d 169.254.169.254 -j REJECT 2>/dev/null || iptables -I OUTPUT -m owner --uid-owner agent -d 169.254.169.254 -j REJECT'

[Install]
WantedBy=multi-user.target
